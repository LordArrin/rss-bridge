<?xml version="1.0"?>
<ruleset name="RSS-Bridge PHPCompatibility">
    <description>
        PHP cross-version compatibility check for RSS-Bridge.
        Requires phpcompatibility/php-compatibility:^10.0.0@dev (PHPCS 4.x support).
    </description>

    <config name="testVersion" value="8.6-"/>

    <file>./actions</file>
    <file>./bin</file>
    <file>./bridges-v2</file>
    <file>./caches</file>
    <file>./formats</file>
    <file>./lib</file>
    <file>./middlewares</file>
    <file>./proxies</file>
    <file>./quirks</file>

    <exclude-pattern>./vendor/*</exclude-pattern>
    <exclude-pattern>./static/*</exclude-pattern>
    <exclude-pattern>./templates/*</exclude-pattern>
    <exclude-pattern>./cache/*</exclude-pattern>
    <exclude-pattern>./config/*</exclude-pattern>
</ruleset>