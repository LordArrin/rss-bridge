{
    "name": "lordarrin/rss-bridge",
    "description": "RSS-Bridge - generate feeds for websites that don't have one",
    "license": "AGPL-3.0-or-later",
    "version": "1.1.9",
    "autoload": {
        "psr-4": {
            "RSSBridge\\Bridges\\": "bridges-v2/",
            "RSSBridge\\Caches\\": "caches/",
            "RSSBridge\\Actions\\": "actions/",
            "RSSBridge\\Formats\\": "formats/",
            "RSSBridge\\Middlewares\\": "middlewares/",
            "RSSBridge\\Proxies\\": "proxies/"
        },
        "files": [
            "lib/Json.php",
            "lib/exceptions.php",
            "lib/utils.php",
            "lib/html.php",
            "lib/contents.php",
            "lib/http.php",
            "lib/logger.php",
            "lib/url.php",
            "lib/seotags.php",
            "lib/compatibility.php"
        ]
    },
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-dom": "*",
        "erusev/parsedown": "^1.8",
        "busybee/urljoin": "^1.0",
        "voku/simple_html_dom": "^5.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3.1",
        "squizlabs/php_codesniffer": "^4.0.4",
        "phpstan/phpstan": "^2.2.9"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "lint:fix": "phpcbf . --standard=phpcs.xml --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
