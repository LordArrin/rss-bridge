{
    "name": "lordarrin/rss-bridge",
    "description": "RSS-Bridge - generate feeds for websites that don't have one",
    "license": "AGPL-3.0-or-later",
    "version": "0.0.0-dev",
    "autoload": {
        "psr-4": {
            "RSSBridge\\Actions\\": "actions/",
            "RSSBridge\\Bridges\\": "bridges-v2/",
            "RSSBridge\\Caches\\": "caches/",
            "RSSBridge\\Formats\\": "formats/",
            "RSSBridge\\Middlewares\\": "middlewares/",
            "RSSBridge\\PHPStan\\Rules\\": "rules/",
            "RSSBridge\\Proxies\\": "proxies/"
        },
        "classmap": [
            "lib/BridgeAbstract.php",
            "lib/BridgeFactory.php",
            "lib/BridgeMetadataCache.php",
            "lib/BrokenBridgeStub.php",
            "lib/Configuration.php",
            "lib/Container.php",
            "lib/FeedExpander.php",
            "lib/FeedItem.php",
            "lib/FeedParser.php",
            "lib/GithubClient.php",
            "lib/LocalHost.php",
            "lib/ParameterValidator.php",
            "lib/Paths.php",
            "lib/RssBridge.php",
            "lib/SafeBridgeLoader.php",
            "lib/VKClient.php"
        ],
        "files": [
            "lib/contents.php",
            "lib/exceptions.php",
            "lib/http.php",
            "lib/json.php",
            "lib/logger.php",
            "lib/notifications.php",
            "lib/utils.php",
            "lib/version.php",
            "quirks/extract.php",
            "quirks/filter.php",
            "quirks/html.php",
            "quirks/json_path.php",
            "quirks/media.php",
            "quirks/media_embed.php",
            "quirks/sanitize_image.php",
            "quirks/seo.php",
            "quirks/srcset.php",
            "quirks/template.php",
            "quirks/unicode.php",
            "quirks/video_embed.php"
        ]
    },
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-tidy": "*",
        "ext-xml": "*",
        "ext-zip": "*",
        "busybee/urljoin": "^1.0",
        "erusev/parsedown": "^1.8"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^10.0.0@dev",
        "phpcsstandards/phpcsutils": "^1.2.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.6",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.1.1",
        "phpunit/phpunit": "^13.4.7",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "lint:fix": "phpcbf . --standard=phpcs.xml --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
