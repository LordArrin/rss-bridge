{
    "name": "lordarrin/rss-bridge",
    "description": "RSS-Bridge - generate feeds for websites that don't have one",
    "license": "AGPL-3.0-or-later",
    "version": "1.2.7",
    "autoload": {
        "psr-4": {
            "RSSBridge\\Bridges\\": "bridges-v2/",
            "RSSBridge\\Caches\\": "caches/",
            "RSSBridge\\Actions\\": "actions/",
            "RSSBridge\\Formats\\": "formats/",
            "RSSBridge\\Middlewares\\": "middlewares/",
            "RSSBridge\\Proxies\\": "proxies/",
            "RSSBridge\\PHPStan\\Rules\\": "rules/"
        },
        "classmap": [
            "lib/BridgeAbstract.php",
            "lib/BridgeFactory.php",
            "lib/BridgeMetadataCache.php",
            "lib/BrokenBridgeStub.php",
            "lib/Configuration.php",
            "lib/Container.php",
            "lib/GithubClient.php",
            "lib/LocalHost.php",
            "lib/FeedExpander.php",
            "lib/FeedItem.php",
            "lib/FeedParser.php",
            "lib/ParameterValidator.php",
            "lib/RssBridge.php",
            "lib/SafeBridgeLoader.php"
        ],
        "files": [
            "lib/contents.php",
            "lib/exceptions.php",
            "lib/http.php",
            "lib/json.php",
            "lib/logger.php",
            "lib/notifications.php",
            "lib/utils.php",
            "quirks/extract.php",
            "quirks/filter.php", 
            "quirks/html.php",
            "quirks/json_path.php",
            "quirks/media.php",
            "quirks/media_embed.php",
            "quirks/seo.php",
            "quirks/srcset.php",
            "quirks/template.php"
        ]
    },
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-dom": "*",
        "erusev/parsedown": "^1.8",
        "busybee/urljoin": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "phpunit/phpunit": "^13.4.5",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "lint:fix": "phpcbf . --standard=phpcs.xml --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
