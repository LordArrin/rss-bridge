{
    "name": "lordarrin/rss-bridge",
    "description": "RSS-Bridge - generate feeds for websites that don't have one",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3.0",
        "PHPCSStandards/PHP_CodeSniffer": "^4.0.4",
        "phpstan/phpstan": "^2.2.8"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "lint:fix": "phpcbf . --standard=phpcs.xml --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}