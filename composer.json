{
    "name": "rss-bridge/rss-bridge",
    "description": "RSS-Bridge — generate feeds for websites that don't have one",
    "license": "AGPL-3.0",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}