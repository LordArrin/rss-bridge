{
    "name": "rss-bridge/rss-bridge",
    "description": "RSS-Bridge - generate feeds for websites that don't have one",
    "license": "AGPL-3.0",
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-sqlite3": "*",
        "ext-zip": "*",
        "ext-ctype": "*",
        "ext-filter": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.11",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "classmap": [
            "lib/",
            "bridges/",
            "formats/",
            "actions/",
            "caches/",
            "middlewares/"
        ],
        "files": [
            "lib/bootstrap.php",
            "lib/config.php",
            "lib/contents.php",
            "lib/html.php",
            "lib/http.php",
            "lib/logger.php",
            "lib/url.php",
            "lib/utils.php",
            "lib/seotags.php",
            "lib/php8backports.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "RssBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:all": "phpunit",
        "lint": "phpcs . --standard=phpcs.xml --warning-severity=0 --extensions=php -p",
        "compat": "phpcs . --standard=phpcompatibility.xml --warning-severity=0 --extensions=php -p",
        "stan": "phpstan analyse --no-progress"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": false
    }
}