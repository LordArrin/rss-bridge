# ==============================================================================
# RSS-Bridge Environment Variables
# ==============================================================================
# This file contains default environment variables for the RSS-Bridge container.
# You can override these by creating a custom .env file in your /config directory,
# or via docker (docker run -e / docker-compose environment:).
#
# Priority (highest first): docker environment > /config/.env > this file.
#
# Memory values accept flexible formats and are normalized automatically:
#   "256" (bare number = megabytes), "512m", "512M", "512MB", "1g", "1.5G"
# Invalid values are rejected with a warning and fall back to the defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# PHP-FPM Process Manager Settings
# ------------------------------------------------------------------------------
# Override default pool sizing and timeouts.
# Applied via template substitution in /etc/php85/php-fpm.d/php-fpm-pool.conf
#
# Rationale for defaults: Every busy worker can block on curl for up to the http
# timeout. A large pool only converts one slow upstream into memory pressure.
#
PHP_FPM_PM_MAX_CHILDREN=15
PHP_FPM_PM_START_SERVERS=3
PHP_FPM_PM_MIN_SPARE_SERVERS=2
PHP_FPM_PM_MAX_SPARE_SERVERS=5
PHP_FPM_PM_MAX_REQUESTS=450
PHP_FPM_PM_PROCESS_IDLE_TIMEOUT=30s

# ------------------------------------------------------------------------------
# PHP Runtime Settings
# ------------------------------------------------------------------------------
# Memory limit per PHP worker: '-1' (unlimited) or a size like '256M' / '1G'.
# Default: -1 (mitigation for recent CVEs). Set an explicit limit in production
# to prevent OOM kills on slow/malformed feeds, especially on low-RAM systems.
PHP_MEMORY_LIMIT=-1

# Maximum time in seconds a script is allowed to run before it is terminated.
# Increase this if you frequently get 504 Gateway Timeout errors on slow websites.
PHP_MAX_EXECUTION_TIME=175

# Set to 'true' to display errors on screen and enable full error reporting.
# WARNING: Do not use in production, it may leak sensitive paths or data.
PHP_DEBUG_MODE=false

# ------------------------------------------------------------------------------
# PHP Performance & Optimization (OPcache)
# ------------------------------------------------------------------------------
# Memory allocated for OPcache, in MB (sizes like '128M' also accepted, min 8).
# Lower this (e.g. 64 or 128) on low-RAM systems.
PHP_OPCACHE_MEMORY=256

# JIT buffer size: '0' (disable) or a size like '256M' / '64M'.
# RSS-Bridge is I/O bound, so JIT provides minimal benefits. Disable to save RAM.
PHP_OPCACHE_JIT_BUFFER=256M

# ------------------------------------------------------------------------------
# Internal Memcached Settings
# ------------------------------------------------------------------------------
# These settings apply ONLY when config.default.ini.php has:
#   [MemcachedCache]
#   type = internal
#
# If type = external, these variables are ignored and host/port are read from
# config.ini.php [MemcachedCache] section instead.
#
# Memory allocated for memcached (e.g. '512m', '1g', or bare '512' = MB).
# Lower this (e.g. '64m' or '128m') on low-RAM systems.
MEMCACHED_MEMORY=512m

# Maximum simultaneous connections to memcached.
MEMCACHED_CONNECTIONS=1024

# Number of worker threads for memcached.
MEMCACHED_THREADS=4
