#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Run PHPUnit tests.
 * 
 * Usage:
 *   bin/test              # Run all tests
 *   bin/test CacheTest    # Run specific test
 */

require __DIR__ . '/../lib/bootstrap.php';

// Check if PHPUnit is available
if (!file_exists(__DIR__ . '/../vendor/bin/phpunit')) {
    fprintf(STDERR, "PHPUnit not found. Run 'composer install' first.\n");
    exit(1);
}

// Forward all arguments to PHPUnit
$args = array_slice($argv, 1);
$command = [__DIR__ . '/../vendor/bin/phpunit', ...$args];

exit(passthru(implode(' ', array_map('escapeshellarg', $command)), $exitCode) ?? $exitCode);
