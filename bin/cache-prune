#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Remove expired items from cache.
 * 
 * Should be run periodically (e.g., via cron) to free up space.
 */

require __DIR__ . '/../vendor/autoload.php';
require __DIR__ . '/../lib/config.php';

$container = require __DIR__ . '/../lib/dependencies.php';

/** @var \RSSBridge\Caches\CacheInterface $cache */
$cache = $container['cache'];

echo sprintf("Cache type: %s\n", get_class($cache));
echo "Pruning expired items...\n";

try {
    $cache->prune();
    echo "Cache pruned successfully\n";
    exit(0);
} catch (\Throwable $e) {
    fprintf(STDERR, "Failed to prune cache: %s\n", $e->getMessage());
    exit(1);
}
