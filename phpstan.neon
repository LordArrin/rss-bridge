parameters:
    level: 8
    paths:
        - .

    excludePaths:
        analyse:
            - vendor/*

    scanFiles:
        - lib/contents.php
        - lib/dependencies.php
        - lib/exceptions.php
        - lib/http.php
        - lib/json.php
        - lib/logger.php
        - lib/notifications.php
        - lib/utils.php
        - lib/version.php
        - quirks/extract.php
        - quirks/filter.php
        - quirks/html.php
        - quirks/json_path.php
        - quirks/media.php
        - quirks/media_embed.php
        - quirks/sanitize_image.php
        - quirks/seo.php
        - quirks/srcset.php
        - quirks/template.php
        - quirks/unicode.php
        - quirks/video_embed.php

    # Deliberate: PHPDoc-derived types are treated as uncertain, so redundant
    # instanceof / null guards are tolerated instead of reported as "always true".
    treatPhpDocTypesAsCertain: false

    ignoreErrors:

rules:
    - RSSBridge\PHPStan\Rules\ForbidOldDomApiRule
    - RSSBridge\PHPStan\Rules\DomTagNameComparisonRule
    - RSSBridge\PHPStan\Rules\Utf8EncodingRule