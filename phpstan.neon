parameters:
    level: 8
    phpVersion: 80600

    paths:
        - .github
        - actions
        - bin
        - bridges-v2
        - caches
        - config
        - formats
        - lib
        - middlewares
        - proxies
        - quirks
        - rules
        - index.php

    excludePaths:
        analyse:
            - vendor/*
            - cache/*

    scanFiles:
        - bin/bench-cache
        - bin/cache-bridge-metadata
        - bin/cache-clear
        - bin/cache-prune
        - bin/check-opcache
        - bin/load-env
        - bin/test
        - bin/test-bridges
        - lib/contents.php
        - lib/dependencies.php
        - lib/exceptions.php
        - lib/http.php
        - lib/json.php
        - lib/logger.php
        - lib/notifications.php
        - lib/utils.php
        - lib/version.php
        - quirks/extract.php
        - quirks/filter.php
        - quirks/html.php
        - quirks/json_path.php
        - quirks/media.php
        - quirks/media_embed.php
        - quirks/sanitize_image.php
        - quirks/seo.php
        - quirks/srcset.php
        - quirks/template.php
        - quirks/unicode.php
        - quirks/video_embed.php

    # PHPDoc-derived types are uncertain: redundant instanceof/null guards tolerated.
    treatPhpDocTypesAsCertain: false

rules:
    - RSSBridge\PHPStan\Rules\ForbidOldDomApiRule
    - RSSBridge\PHPStan\Rules\DomTagNameComparisonRule
    - RSSBridge\PHPStan\Rules\Utf8EncodingRule
