parameters:
    level: 7
    paths:
        - .

    excludePaths:
        analyse:
            - vendor/*

    scanFiles:
        - lib/contents.php
        - lib/dependencies.php
        - lib/exceptions.php
        - lib/http.php
        - lib/json.php
        - lib/logger.php
        - lib/notifications.php
        - lib/utils.php
        - lib/version.php
        - quirks/extract.php
        - quirks/filter.php
        - quirks/html.php
        - quirks/json_path.php
        - quirks/media.php
        - quirks/media_embed.php
        - quirks/sanitize_image.php
        - quirks/seo.php
        - quirks/srcset.php
        - quirks/template.php
        - quirks/unicode.php

    treatPhpDocTypesAsCertain: false

    ignoreErrors:

    reportUnmatchedIgnoredErrors: false

rules:
    - RSSBridge\PHPStan\Rules\ForbidOldDomApiRule
    - RSSBridge\PHPStan\Rules\DomTagNameComparisonRule