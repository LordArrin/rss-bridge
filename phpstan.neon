includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 5
    paths:
        - .

    excludePaths:
        analyse:
            - vendor/*

    scanFiles:
        - lib/exceptions.php
        - lib/http.php
        - lib/logger.php
        - lib/json.php
        - lib/utils.php
        - lib/contents.php
        - quirks/template.php
        - quirks/html.php
        - quirks/srcset.php
        - quirks/extract.php
        - quirks/media.php
        - quirks/media_embed.php
        - quirks/json_path.php
        - quirks/seo.php

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        - '#Variable \$\w+ on left side of \?\? always exists#'

    reportUnmatchedIgnoredErrors: false

rules:
    - RSSBridge\PHPStan\Rules\ForbidOldDomApiRule