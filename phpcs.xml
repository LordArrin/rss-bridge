<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="RSS-Bridge Ruleset">
  <description>
    Modernized ruleset for RSS-Bridge (PHP 8.6+).
    Based on PSR-12 with strict typing and modern PHP practices.
  </description>

  <!-- Specify the target PHP version for the analyzers to work correctly. -->
  <config name="php_version" value="80600"/>

  <!-- Default check paths -->
  <file>./.github</file>
  <file>./actions</file>
  <file>./bin</file>
  <file>./bridges-v2</file>
  <file>./caches</file>
  <file>./config</file>
  <file>./formats</file>
  <file>./lib</file>
  <file>./middlewares</file>
  <file>./proxies</file>
  <file>./quirks</file>

  <!-- Exceptions -->
  <exclude-pattern>./cache/*</exclude-pattern>
  <exclude-pattern>./config.default.ini.php</exclude-pattern>
  <exclude-pattern>./config.ini.php</exclude-pattern>
  <exclude-pattern>./static/*</exclude-pattern>
  <exclude-pattern>./templates/*</exclude-pattern>
  <exclude-pattern>./vendor/*</exclude-pattern>

  <!-- Basic standard PSR-12 -->
  <rule ref="PSR12">
    <!--
      NOTE: The MissingNamespace exception allows global functions in lib/utils.php,
      lib/contents.php, lib/exceptions.php, lib/http.php, lib/logger.php, and quirks/.
      All classes use proper namespaces (RSSBridge\...).
    -->
    <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
  </rule>

  <!-- Requiring strong typing in all files -->
  <rule ref="Generic.PHP.RequireStrictTypes"/>

  <!-- Required for PHP 8+: Disable loose comparisons (requires === and !==) -->
  <rule ref="Squiz.Operators.ComparisonOperatorUsage"/>

  <!-- Short array syntax [] -->
  <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

  <!-- Line length limitation -->
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="240"/>
      <property name="absoluteLineLimit" value="240"/>
      <property name="ignoreComments" value="true"/>
    </properties>
  </rule>

  <!-- Disabled, deprecated, and specific Features -->
  <rule ref="Generic.PHP.ForbiddenFunctions">
    <properties>
      <property name="forbiddenFunctions" type="array">
        <element key="sizeof" value="count"/>
        <element key="delete" value="unset"/>
        <element key="print" value="echo"/>
        <element key="join" value="implode"/>
        <element key="chop" value="rtrim"/>
        <element key="doubleval" value="(float)"/>
        <element key="floatval" value="(float)"/>
        <element key="intval" value="(int)"/>
        <element key="strval" value="(string)"/>
        <element key="is_null" value="=== null"/>
        <element key="create_function" value="Closure::fromCallable()"/>
        <element key="utf8_encode" value="mb_convert_encoding"/>
        <element key="utf8_decode" value="mb_convert_encoding"/>
        <element key="returnClientError" value="throwClientException"/>
        <element key="returnServerError" value="throwServerException"/>
        <element key="var_dump" value=""/>
        <element key="print_r" value=""/>
        <element key="var_export" value=""/>
        <element key="debug_print_backtrace" value=""/>
        <element key="phpinfo" value=""/>
        <element key="eval" value=""/>
        <element key="extract" value=""/>
        <element key="shell_exec" value=""/>
        <element key="exec" value=""/>
        <element key="system" value=""/>
        <element key="passthru" value=""/>
        <element key="popen" value=""/>
        <element key="proc_open" value=""/>
        <element key="pcntl_exec" value=""/>
      </property>
    </properties>
  </rule>

  <!-- Code analysis -->
  <rule ref="Generic.Classes.DuplicateClassName"/>
  <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>
  <rule ref="Generic.CodeAnalysis.UnnecessaryFinalModifier"/>
  <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
  <rule ref="Generic.Files.ByteOrderMark"/>
  <rule ref="Generic.Functions.FunctionCallArgumentSpacing"/>
  <rule ref="Generic.NamingConventions.UpperCaseConstantName"/>
  <rule ref="Generic.PHP.LowerCaseConstant"/>
  <rule ref="Generic.PHP.LowerCaseType"/>
  <rule ref="Generic.Strings.UnnecessaryStringConcat"/>

  <!-- Formatting and whitespaces -->
  <rule ref="Squiz.WhiteSpace.FunctionOpeningBraceSpace"/>
  <rule ref="Squiz.Strings.ConcatenationSpacing">
    <properties>
      <property name="spacing" value="1"/>
      <property name="ignoreNewlines" value="true"/>
    </properties>
  </rule>
  <rule ref="Squiz.WhiteSpace.CastSpacing"/>
  <rule ref="Squiz.WhiteSpace.OperatorSpacing"/>
  <rule ref="Squiz.WhiteSpace.SemicolonSpacing"/>
  <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
    <properties>
      <property name="ignoreBlankLines" value="false"/>
    </properties>
  </rule>

  <!-- Lines -->
  <rule ref="Squiz.Strings.DoubleQuoteUsage">
    <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>
  </rule>

</ruleset>
